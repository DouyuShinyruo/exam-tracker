.container {
  padding: 20rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

.team-card {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
}

.team-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.team-name {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
  flex: 1;
  margin-right: 16rpx;
}

.member-count {
  font-size: 24rpx;
  color: #1890FF;
  background-color: #e6f7ff;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
}

.team-info {
  border-top: 1rpx solid #f0f0f0;
  padding-top: 20rpx;
}

.info-row {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.info-label {
  font-size: 26rpx;
  color: #999;
  width: 120rpx;
}

.info-value {
  font-size: 26rpx;
  color: #666;
  flex: 1;
}

.invite-code {
  color: #1890FF;
  font-weight: 500;
  letter-spacing: 2rpx;
}

.copy-btn {
  font-size: 24rpx;
  color: #1890FF;
  padding: 8rpx 16rpx;
  margin-left: 16rpx;
}

.copy-btn:active {
  color: #096dd9;
}

.section {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
}

.section-title {
  font-size: 30rpx;
  font-weight: 500;
  color: #333;
  display: block;
  margin-bottom: 20rpx;
}

.member-list {
  border-top: 1rpx solid #f0f0f0;
  padding-top: 16rpx;
}

.member-item {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.member-item:last-child {
  border-bottom: none;
}

.member-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  margin-right: 20rpx;
  background-color: #f0f0f0;
}

.member-info {
  flex: 1;
}

.member-name {
  font-size: 28rpx;
  color: #333;
  display: block;
  margin-bottom: 4rpx;
}

.member-join-time {
  font-size: 22rpx;
  color: #999;
}

.action-section {
  margin-top: 40rpx;
}

.btn-share {
  background-color: #1890FF;
  color: #fff;
  border-radius: 16rpx;
  font-size: 32rpx;
  padding: 28rpx;
  border: none;
  margin-bottom: 20rpx;
}

.btn-share:active {
  background-color: #096dd9;
}

.btn-leave {
  background-color: #fff;
  color: #999;
  border: 2rpx solid #ddd;
  border-radius: 16rpx;
  font-size: 30rpx;
  padding: 24rpx;
}

.btn-leave:active {
  background-color: #f5f5f5;
}

.btn-delete {
  background-color: #fff;
  color: #FF4D4F;
  border: 2rpx solid #FF4D4F;
  border-radius: 16rpx;
  font-size: 30rpx;
  padding: 24rpx;
}

.btn-delete:active {
  background-color: #fff1f0;
}

.loading {
  display: flex;
  justify-content: center;
  padding: 200rpx 0;
  color: #999;
  font-size: 28rpx;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 0;
}

.empty-text {
  font-size: 32rpx;
  color: #999;
}
